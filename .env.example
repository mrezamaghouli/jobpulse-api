# =============================================================================
# JobPulse API - Example Environment
# Copy this file to .env and change real secrets before running production.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=JobPulse API
APP_VERSION=1.0.0
APP_ENV=development

PORT=8000
JOB_PROVIDER=json

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Required to use protected /jobs* endpoints. Comma-separated list, so keys
# can be rotated by adding a new one and removing the old one later. Set a
# unique local key before using protected /jobs* routes -- leaving this
# empty makes every /jobs* request fail closed with 503.
JOBPULSE_PUBLIC_API_KEYS=

# Legacy single-key middleware setting (api_key_auth in app/main.py). Does
# not control public /jobs* authentication -- that uses
# JOBPULSE_PUBLIC_API_KEYS above.
API_KEY=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# PostgreSQL
# For Docker Compose use: POSTGRES_HOST=db
# For local PowerShell scripts use: POSTGRES_HOST=127.0.0.1
# -----------------------------------------------------------------------------
POSTGRES_DB=jobpulse
POSTGRES_USER=jobpulse_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# LinkedIn Collector - Basic Search Defaults
# -----------------------------------------------------------------------------
LINKEDIN_BROWSER=chrome
LINKEDIN_KEYWORDS=UX Designer
LINKEDIN_LOCATION=Germany
LINKEDIN_LIMIT=20
LINKEDIN_MAX_PAGES=3
LINKEDIN_LOOKBACK_DAYS=30
LINKEDIN_WORK_MODE=

# -----------------------------------------------------------------------------
# LinkedIn Collector - Safety / Smart Search
# -----------------------------------------------------------------------------
LINKEDIN_QUERY_COOLDOWN_HOURS=12
LINKEDIN_SKIP_EXISTING_ENRICHED=true
LINKEDIN_QUERY_RETRY_COUNT=1
LINKEDIN_QUERY_RETRY_DELAY_SECONDS=10
LINKEDIN_STOP_AFTER_NO_NEW_SCROLLS=2

# Optional: smart planner output file
LINKEDIN_QUERIES_FILE=config/linkedin_smart_queries.json

# -----------------------------------------------------------------------------
# LinkedIn Scheduling / Legacy Settings
# -----------------------------------------------------------------------------
LINKEDIN_STALE_DAYS=7
LINKEDIN_SCHEDULE_INTERVAL_MINUTES=180

# -----------------------------------------------------------------------------
# Company Enrichment
# -----------------------------------------------------------------------------
COMPANY_ENRICH_LIMIT=3
COMPANY_ENRICH_STALE_DAYS=30

# -----------------------------------------------------------------------------
# Job Lifecycle
# active -> inactive -> archived
# Hard delete should stay false until production backups exist.
# -----------------------------------------------------------------------------
JOB_INACTIVE_AFTER_DAYS=30
JOB_ARCHIVE_AFTER_DAYS=60
JOB_HARD_DELETE_ENABLED=false
JOB_HARD_DELETE_AFTER_DAYS=120

# -----------------------------------------------------------------------------
# Production Collection Runner Defaults
# safe / balanced / strong are selected by CLI argument, not env.
# -----------------------------------------------------------------------------
PRODUCTION_COLLECTION_PROFILE=balanced

# -----------------------------------------------------------------------------
# Tor outbound routing (experimental, Phase 1 -- see scripts/tor/).
# Disabled by default: when TOR_ENABLED=false, browser.launch() calls get
# no proxy argument at all, identical to pre-Tor behavior. Only set the
# rest of these when running with docker-compose.tor.yml locally.
# -----------------------------------------------------------------------------
TOR_ENABLED=false
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
# Required whenever TOR_ENABLED=true. Never commit a real value; used only
# to authenticate to the local Tor control port, never sent anywhere else.
# TOR_CONTROL_PASSWORD_FILE (a file PATH, not the secret) takes priority
# over this when set -- see app/config.py get_tor_control_password().
# Production uses TOR_CONTROL_PASSWORD_FILE (e.g. pointed at a mounted
# /run/secrets/tor_control_password), never this plaintext env var.
TOR_CONTROL_PASSWORD=
TOR_CONTROL_PASSWORD_FILE=
TOR_IP_CHECK_URL=https://check.torproject.org/api/ip
# Minimum seconds between NEWNYM signals to the same Tor instance
# (enforced across separate process invocations, see
# scripts/tor/circuit_manager.py), and the longest request_new_identity()
# will sleep waiting for that cooldown before raising a transient error.
TOR_NEWNYM_MIN_INTERVAL_SECONDS=10
TOR_NEWNYM_MAX_WAIT_SECONDS=5

# -----------------------------------------------------------------------------
# Tor Phase 2: read-only observability / structured events (see
# scripts/tor/circuit_manager.py, scripts/tor/observability.py). Still no
# automatic rotation of any kind -- these only bound how much lifecycle
# history is retained and how stale a stuck rotation must look before an
# operator is told about it via recover_circuit().
# -----------------------------------------------------------------------------
# Bounded retention for tor_circuit_events (oldest rows pruned first,
# synchronously, on every write -- no background cleanup daemon). Clamped
# to [100, 100000] regardless of the configured value.
TOR_EVENT_MAX_ROWS=1000
# How long (seconds) a circuit may sit in STATUS_DRAINING before
# observability reports it as stale -- almost certainly a crash mid-NEWNYM.
# Purely observational: reaching this threshold never auto-recovers the
# circuit; only an explicit recover_circuit() call does.
TOR_STALE_DRAINING_THRESHOLD_SECONDS=300

# -----------------------------------------------------------------------------
# Search transport (Phase 3.4K, controlled rollout -- see
# scripts/search_transport/). This is the SOLE gate for whether LinkedIn
# collection traffic is routed through proxy transport -- setting
# SEARCH_TRANSPORT=proxy alone is sufficient; TOR_ENABLED above is a
# separate, unrelated flag (infra/monitoring/dark-launch only) and is
# deliberately NOT read by any collection code path (see
# tests/test_tor_production_dark_launch.py::
# test_no_collection_script_sets_tor_enabled_true). Leaving TOR_ENABLED=true
# does NOT enable proxy transport, and leaving it false does NOT block it.
# Default is "direct", which preserves the previous no-proxy network
# route and connect/read timeout defaults. Phase 3.4K still adds
# classification, observability, bounded-retry, auth-safety, and process
# deadline control-flow on top of that default route -- see
# scripts/search_transport/ and scripts/providers/linkedin_browser_provider.py.
# An explicitly-set value that
# is neither "direct" nor "proxy" (e.g. a typo) fails closed with a
# configuration error at startup rather than silently falling back to
# "direct" -- see app/config.py::get_search_transport_mode(). Do not flip
# to "proxy" in production without first running
# scripts/search_transport_benchmark.py and standing up a separate Tor
# sidecar the API can actually reach (see docs/PRODUCTION_RUNBOOK.md).
# -----------------------------------------------------------------------------
SEARCH_TRANSPORT=direct
SEARCH_TRANSPORT_DIRECT_CONNECT_TIMEOUT_MS=120000
SEARCH_TRANSPORT_DIRECT_READ_TIMEOUT_MS=30000
# Wider than direct mode: Tor circuit build/handshake latency is higher and
# more variable than a direct connection -- a slow Tor connect must not be
# misclassified as a LinkedIn block.
SEARCH_TRANSPORT_PROXY_CONNECT_TIMEOUT_MS=180000
SEARCH_TRANSPORT_PROXY_READ_TIMEOUT_MS=45000
# How long the proxy transport waits for a TCP connect to the SOCKS port
# before declaring the proxy unavailable and failing explicitly (never
# falls back to direct).
SEARCH_TRANSPORT_PROXY_PROBE_TIMEOUT_MS=3000
# Per-task retry budget for job_search_demand_queue rows -- a row's
# fail_count reaching this value moves it to terminal 'failed' instead of
# being requeued to 'pending' forever.
SEARCH_DEMAND_MAX_ATTEMPTS=3