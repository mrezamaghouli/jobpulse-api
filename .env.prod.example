POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jobpulse
POSTGRES_USER=jobpulse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Required to use protected /jobs* endpoints. Comma-separated list, so keys
# can be rotated by adding a new one and removing the old one later.
#
# Do NOT set this here. docker-compose.prod.yml loads env files in this
# order: .api_keys.env, /opt/jobpulse/.admin.env, .env -- the last file
# loaded wins on duplicate keys, so an assignment in this file would
# silently override the real secret from .api_keys.env. Define it only in:
#
# /opt/jobpulse/.api_keys.env:
# JOBPULSE_PUBLIC_API_KEYS=<generate-one-or-more-strong-random-keys>
#
# Leaving it unset makes every /jobs* request fail closed with 503 -- run
# scripts/check_production_readiness.py before deploying to catch this.

LINKEDIN_BROWSER=chromium
LINKEDIN_QUERY_COOLDOWN_HOURS=0
LINKEDIN_SKIP_EXISTING_ENRICHED=true

JOB_INACTIVE_AFTER_DAYS=14
JOB_ARCHIVE_AFTER_DAYS=45
JOB_HARD_DELETE_ENABLED=false

JOB_SEARCH_MIN_RELEVANCE_SCORE=0.38
JOB_SEARCH_KEYWORD_MIN_RELEVANCE_SCORE=0.12
SEARCH_DEMAND_MIN_RESULTS=3
SEARCH_DEMAND_LINKEDIN_LIMIT=20
SEARCH_DEMAND_LINKEDIN_MAX_PAGES=2